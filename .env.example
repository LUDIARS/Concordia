# Concordia config (.env)

# loopback bind. Tailnet 越えは v0.3.
CONCORDIA_HOST=127.0.0.1
CONCORDIA_PORT=17330
CONCORDIA_LOG_LEVEL=info
CONCORDIA_DB_PATH=

# heartbeat タイムアウト (default 5 分)
CONCORDIA_LOST_AFTER_SEC=300
# abandoned タイムアウト (default 24h)
CONCORDIA_ABANDONED_AFTER_SEC=86400
# session_events の auto-purge 期間 (default 90 日)
CONCORDIA_PURGE_AFTER_DAYS=90
# sweeper 周期 (default 60 秒)
CONCORDIA_SWEEPER_INTERVAL_MS=60000

# LLM report 生成 (省略可)
ANTHROPIC_API_KEY=
CONCORDIA_REPORT_MODEL=claude-haiku-4-5

# /v1/spawn と /v1/admin/spawn-session で body.cwd が省略された時の default.
# 解決順:
#   1. この env (明示指定、 最優先)
#   2. `E:\Document\Ars` が存在する Windows 機ならその値 (LUDIARS 運用既定)
#   3. 空 → フォールバック無し (Concordia 自身の cwd で spawn)
# 既定で問題なければ env を設定する必要は無い. 別パスに変えたい時だけ書く:
#   CONCORDIA_SPAWN_DEFAULT_CWD=D:\work\my-org
CONCORDIA_SPAWN_DEFAULT_CWD=

# ─── Discord-UI bot (spec/discord-ui.md) ────────────────────────────────
# `1` で Discord bot を起動する. 未設定 / 空文字なら完全 no-op (Web UI のみで運用).
CONCORDIA_DISCORD_ENABLED=
# Discord Developer Portal で Bot Application を作って発行した token.
# Privileged intent "MessageContent" を Developer Portal で有効化すること.
CONCORDIA_DISCORD_TOKEN=
# Bot を招待するターゲット server (guild) の ID.
CONCORDIA_DISCORD_GUILD_ID=

# Slash command registration uses Discord Application ID.
CONCORDIA_DISCORD_APPLICATION_ID=

# ─── Slack platform bot (spec/feature/slack-platform.md) ────────────────
# ★ 推奨はサービス内設定: Web UI「Slack」タブ / `/v1/admin/slack` で token/channel を
#    設定でき、保存時点で hot 再接続する (token は暗号化して DB 保存)。以下 env は
#    初期 bootstrap / フォールバック用 (DB 設定が優先)。詳細 spec/setup/slack.md。
# `1` で Slack bot を起動する. 未設定 / 空文字なら完全 no-op.
# Discord と同時起動可（両方 ChatPlatform として eventBus を購読する）。
CONCORDIA_SLACK_ENABLED=
# Bot User OAuth Token (xoxb-). scope: chat:write, channels:history, channels:read.
CONCORDIA_SLACK_BOT_TOKEN=
# App-Level Token (xapp-) for Socket Mode. scope: connections:write.
# Socket Mode + Interactivity + Event Subscriptions(message.channels) を ON にする.
CONCORDIA_SLACK_APP_TOKEN=
# 運用チャンネル ID (C...). このチャンネル内で thread-per-session 多重化する.
CONCORDIA_SLACK_CHANNEL_ID=
# 「作業中」インジケータを除去する無進捗時間 (秒, 既定 60).
# slash は app 設定で `/concordia` を 1 個登録 (commands scope, Socket Mode なので request URL 不要).
CONCORDIA_SLACK_WORKING_IDLE_SEC=
# DB に保存する Slack token を暗号化する secret-box のマスター鍵 (任意 passphrase).
# 空なら起動時に cwd の concordia.secret.key を自動生成して使用 (gitignore 済).
CONCORDIA_SECRET_KEY=
