# Concordia config (.env)

# loopback bind. Tailnet 越えは v0.3.
CONCORDIA_HOST=127.0.0.1
CONCORDIA_PORT=17330
CONCORDIA_LOG_LEVEL=info
CONCORDIA_DB_PATH=

# heartbeat タイムアウト (default 5 分)
CONCORDIA_LOST_AFTER_SEC=300
# abandoned タイムアウト (default 24h)
CONCORDIA_ABANDONED_AFTER_SEC=86400
# session_events の auto-purge 期間 (default 90 日)
CONCORDIA_PURGE_AFTER_DAYS=90
# sweeper 周期 (default 60 秒)
CONCORDIA_SWEEPER_INTERVAL_MS=60000

# LLM report 生成 (省略可)
ANTHROPIC_API_KEY=
CONCORDIA_REPORT_MODEL=claude-haiku-4-5
