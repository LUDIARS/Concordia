# dependencies
node_modules/

# build artifacts
dist/
out/
build/
web/dist/
web/tsconfig.tsbuildinfo

# tools/sync-skill.mjs が ~/.claude/skills/concordia へ skill 内容を反映する
# 際の loopback. リポ root の .claude/skills/ 配下は repo に含めない.
.claude/

# logs
*.log
npm-debug.log*

# env / secrets
.env
.env.*
!.env.example
.env.secrets

# OS
.DS_Store
Thumbs.db

# editor
.idea/
.vscode/
*.swp
*.swo

# tests / coverage
coverage/
.nyc_output/

# local data
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal
concordia.db*

# spawn endpoint bearer token (generated on first /v1/spawn use; never committed)
.spawn.token

# secret-box master key (生成は初回利用時; Slack token 等を暗号化する鍵; never committed)
concordia.secret.key

# 委託 prompt の実行時生成物
delegation-prompts/

# vite.config.ts はドメイン名を含むためローカル管理 (vite.config.example.ts を参照)
web/vite.config.ts

# runtime logs (Vestigium / Lictor)
logs/
web/logs/
bash.exe.stackdump
