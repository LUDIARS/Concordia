# dependencies
node_modules/

# build artifacts
dist/
out/
build/
web/dist/
web/tsconfig.tsbuildinfo

# tools/sync-skill.mjs が ~/.claude/skills/concordia へ skill 内容を反映する
# 際の loopback. リポ root の .claude/skills/ 配下は repo に含めない.
.claude/

# logs
*.log
npm-debug.log*

# env / secrets
.env
.env.*
!.env.example
.env.secrets

# OS
.DS_Store
Thumbs.db

# editor
.idea/
.vscode/
*.swp
*.swo

# tests / coverage
coverage/
.nyc_output/

# local data
/concordia.config.json
.federation-config-cache.json
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal
concordia.db*

# spawn endpoint bearer token (generated on first /v1/spawn use; never committed)
.spawn.token

# secret-box master key (生成は初回利用時; Slack token 等を暗号化する鍵; never committed)
concordia.secret.key

# 委託 prompt の実行時生成物
delegation-prompts/

# 委託先が置くコミット代行の依頼 (spec/feature/delegation.md §14)。 broker は stage 前に
# 消すが、 消せなかった場合に `git add -A` が依頼そのものを履歴へ入れないための保険。
.concordia-commit.json

# vite.config.ts はドメイン名を含むためローカル管理 (vite.config.example.ts を参照)
web/vite.config.ts

# runtime logs (Vestigium / Lictor)
logs/
web/logs/
bash.exe.stackdump

# Anatomia retune ローカル状態（反復カウンタ等）。 ビジネスドメイン定義の正本は
# spec/domains/ へ移した。 追跡するのは layers.json だけで、 これは解析キャッシュではなく
# リポジトリが持つ層 (プログラムドメイン) の宣言。 追跡しないと Revisor のゲートから
# リポジトリ固有の層が見えず、 規約や依存から推定できない変更 anchor が「未分類」になる。
# なお `.anatomia/` とディレクトリごと除外する形にはしないこと — git は除外ディレクトリ内の
# ファイルを `!` で再包含できないので、 layers.json をコミットできなくなる。
.anatomia/*
!.anatomia/layers.json

# ローカル review/ は中央 Review/<repo>/ に集約する (per-repo review/ は追跡しない)
review/*
# 例外: 複数エージェントが分担して着手する要対応リストは、担当の引き継ぎに要るので追跡する
# (ディレクトリごと除外すると git が中を走査せず否定が効かないので review/* と書く)
!review/FIXLIST-*.md

# ローカル依存ライブラリ (git submodule update --init でセットアップ)
/lib/*
!/lib/aop-metrics/
!/lib/aop-metrics/**
/plugins/

# spec/**/*.md から機械生成する索引 (tools/build-spec-index.mjs)。
# 追跡すると `npm run build` のたびに main が dirty になり、Revisor が
# 「worktree is no longer clean」で全 PR のマージを拒否する。正本は spec/ の
# frontmatter なので、必要なときに `npm run build:spec-index` で作り直す。
/spec-index.jsonl

# アーキテクチャ解析レポート (HTML / JSON) は生成物。 このリポジトリは public なので、
# 解析成果そのものは追跡しない (秘匿ルール: 名称と一言説明までに留める)。
# 再生成の手順は spec/setup/reproducible-build.md にある。
/report/
