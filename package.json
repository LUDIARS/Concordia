{
  "name": "concordia",
  "version": "0.1.0",
  "description": "Multi-agent CLI session coordinator. Tracks active Claude Code / Gemini CLI / Codex CLI sessions per repo.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run sync:skill && tsc -p tsconfig.json && cd web && npm run build",
    "dev": "npm run sync:skill && concurrently -n be,fe -c blue,magenta \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "cd web && npm run dev",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "sync:skill": "node tools/sync-skill.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.7.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
