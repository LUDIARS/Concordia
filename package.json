{
  "name": "concordia",
  "version": "0.1.0",
  "description": "Multi-agent CLI session coordinator. Tracks active Claude Code / Gemini CLI / Codex CLI sessions per repo.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run sync:skill && npm run build:spec-index && tsc -p tsconfig.json && cd web && npm run build",
    "build:spec-index": "node tools/build-spec-index.mjs",
    "dev": "npm run sync:skill && concurrently --kill-others-on-fail -n be,fe -c blue,magenta \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "node --watch --import tsx --env-file-if-exists=.env src/server.ts",
    "cost:worker": "node --import tsx --env-file-if-exists=.env src/cost-worker.ts",
    "db:drop-obsolete-excubitor": "node --import tsx src/drop-obsolete-excubitor.ts",
    "chat:worker": "node --import tsx --env-file-if-exists=.env src/chat-worker.ts",
    "control:worker": "node --import tsx --env-file-if-exists=.env src/control-worker.ts",
    "workflow:worker": "node --import tsx --env-file-if-exists=.env src/workflow-worker.ts",
    "dev:web": "cd web && npm run dev",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && npm run depcruise",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "sync:skill": "node tools/sync-skill.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@ludiars/aop-metrics": "file:lib/aop-metrics",
    "@ludiars/blackbox": "file:lib/blackbox",
    "@ludiars/memory": "file:lib/memory",
    "@ludiars/vestigium": "file:lib/vestigium",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^11.7.0",
    "croner": "^10.0.1",
    "discord.js": "^14.26.4",
    "hono": "^4.12.25",
    "js-yaml": "^4.3.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.3",
    "dependency-cruiser": "^18.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "license": "MIT"
}
