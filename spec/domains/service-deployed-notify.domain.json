{
  "name": "service-deployed-notify",
  "description": "Excubitor の service.deployed を受信し、Revisor 差分を任意に組み立て、プロジェクト単位の配送先へ安全に通知する。",
  "membership": [
    { "pathPattern": "(^|/)src/deploy/service-deployed(\\.test)?\\.ts$" },
    { "pathPattern": "(^|/)src/deploy/service-deployed-runtime(\\.test)?\\.ts$" },
    { "pathPattern": "(^|/)src/api/service-deployed(\\.test)?\\.ts$" },
    { "pathPattern": "(^|/)src/api/register-core\\.ts$" },
    { "pathPattern": "(^|/)src/bootstrap/core\\.ts$" },
    { "pathPattern": "(^|/)src/db/(schema|project-codes-repo)\\.ts$" },
    { "pathPattern": "(^|/)src/config/settings/definitions/chat\\.ts$" },
    { "pathPattern": "(^|/)web/src/(api|pages/ProjectCodes)\\.tsx?$" }
  ],
  "specRefs": ["spec/feature/service-deployed-notify.md"],
  "rationale": "受信 HTTP、重複排除、Revisor 差分の照会、通知配送を service.deployed という一つの業務イベントの境界に閉じる。"
}
