{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "session-start",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "source": "${source}"
              }
            }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node E:/Document/Ars/Memoria/server/hooks/codex-prompt.mjs",
            "commandWindows": "node E:\\Document\\Ars\\Memoria\\server\\hooks\\codex-prompt.mjs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "prompt",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "turn_id": "${turn_id}",
                "prompt": "${prompt}"
              }
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "tool-result",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "turn_id": "${turn_id}",
                "tool_name": "${tool_name}",
                "tool_use_id": "${tool_use_id}",
                "tool_input": "${tool_input}",
                "tool_response": "${tool_response}"
              }
            }
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "edit",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "turn_id": "${turn_id}",
                "tool_name": "${tool_name}",
                "tool_use_id": "${tool_use_id}",
                "tool_input": "${tool_input}",
                "tool_response": "${tool_response}"
              }
            }
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "compact",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "turn_id": "${turn_id}",
                "trigger": "${trigger}"
              }
            }
          }
        ]
      }
    ],
    "Stop": [],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "concordia-hooks",
            "tool": "run_hook",
            "input": {
              "event": "post-compact",
              "ctx": {
                "session_id": "${session_id}",
                "transcript_path": "${transcript_path}",
                "cwd": "${cwd}",
                "hook_event_name": "${hook_event_name}",
                "model": "${model}",
                "turn_id": "${turn_id}",
                "trigger": "${trigger}"
              }
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Document/Ars/Concordia/tools/concordia-hook.mjs\" session-end --provider=codex-cli"
          }
        ]
      }
    ]
  }
}
