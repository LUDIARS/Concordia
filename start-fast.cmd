@echo off
set NODE_ENV=production
set CONCORDIA_LOG_LEVEL=warn
set CONCORDIA_HTTP_CACHE_ENABLED=1
set CONCORDIA_HTTP_CACHE_REDIS_READ=0
set CONCORDIA_HTTP_SLOW_MS=60
