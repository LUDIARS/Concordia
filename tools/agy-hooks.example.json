{
  "concordia-harness": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|write_file|create_file|replace_file_content|edit_file|apply_patch|delete_file|multi_replace_file_content|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "node E:/Document/Ars/Concordia/tools/agy-hook.mjs pre-tool --runtime=E:/Document/Ars/.claude/state/harness-runtime --config=E:/Document/Ars/.claude/state/harness-supervisor.json",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node E:/Document/Ars/Concordia/tools/agy-hook.mjs post-tool", "timeout": 10 }
        ]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "node E:/Document/Ars/Concordia/tools/agy-hook.mjs prompt", "timeout": 10 }
    ]
  }
}
